{
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pending-tx",
      "destination": "https://haptix-relay.onrender.com/pending-tx"
    },
    {
      "source": "/submit-signature",
      "destination": "https://haptix-relay.onrender.com/submit-signature"
    },
    {
      "source": "/status",
      "destination": "https://haptix-relay.onrender.com/status"
    },
    {
      "source": "/decline",
      "destination": "https://haptix-relay.onrender.com/decline"
    },
    {
      "source": "/tx-signature",
      "destination": "https://haptix-relay.onrender.com/tx-signature"
    }
  ]
}
