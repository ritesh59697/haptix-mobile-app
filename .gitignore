# Foundry build output -- regenerated by `forge build`
out/
cache/

# Dependencies -- restored by `forge install` (see .gitmodules)
lib/

# Broadcast logs and deployment history
broadcast/

# Secrets. The deploy flow uses an encrypted Foundry keystore
# (~/.foundry/keystores/) which lives outside this repo -- nothing secret should
# ever land here, but fail closed.
.env
.env.*
!.env.example
*.key
*.pem
keystore/
*.keystore

# Intermediate output of tools/genvec.mjs. The Solidity it generates
# (test/Vectors.sol) IS committed -- the test suite will not compile without it,
# and regenerating would mint fresh keypairs that no longer match the fixtures
# hardcoded in RealPasskey.t.sol.
tools/vectors.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*~

# Node (the harness has no dependencies, but keep this honest)
node_modules/
npm-debug.log*
dist/
